const { io } = require("socket.io-client");

const getUserByIdSocket = async ({ user_id }) => {
	return new Promise((resolve, reject) => {
		const socket = io("http://localhost:8002", {
			autoConnect: true,
			reconnectionAttempts: 3,
		});

		console.log("User connected:", socket.id);

        socket.on("register", (userId) => {
            users[userId] = socket.id;
            socket.emit("registered", userId);
            console.log(`User registered: ${userId} -> ${socket.id}`);
        });

        socket.on("offer", ({ offer, to }) => {
            if (users[to]) {
                io.to(users[to]).emit("offer", { offer, from: socket.id });
                console.log(`Sending offer from ${socket.id} to ${to}`);
            } else {
                console.log(`User ${to} not found`);
            }
        });

        socket.on("answer", ({ answer, to }) => {
            if (users[to]) {
                io.to(users[to]).emit("answer", { answer, from: socket.id });
                console.log(`Sending answer from ${socket.id} to ${to}`);
            } else {
                console.log(`User ${to} not found`);
            }
        });

        socket.on("candidate", ({ candidate, to }) => {
            if (users[to]) {
                io.to(users[to]).emit("candidate", { candidate, from: socket.id });
                console.log(`Sending ICE candidate from ${socket.id} to ${to}`);
            } else {
                console.log(`User ${to} not found`);
            }
        });

        socket.on("disconnect", () => {
            console.log("User disconnected:", socket.id);
            for (const userId in users) {
                if (users[userId] === socket.id) {
                    delete users[userId];
                    console.log(`User ${userId} removed from registry`);
                }
            }
        });
	});
};



module.exports = {  getUserByIdSocket };
